{
  "name": "gai-ara",
  "private": true,
  "version": "0.1.0",
  "description": "가이 알아? - 제주 맞팔 관계 몇다리 실험 서비스",
  "scripts": {
    "dev": "pnpm --filter @gai-ara/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @gai-ara/db generate",
    "db:migrate": "pnpm --filter @gai-ara/db migrate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "dependencies": {
    "@neon/config": "^1.3.2",
    "@neon/env": "^1.2.3"
  }
}
