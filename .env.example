# PostgreSQL 연결 문자열 (로컬 개발용 예시)
DATABASE_URL=postgres://gaiara:gaiara@localhost:5432/gaiara

# Instagram username 해싱에 사용하는 서버 전용 비밀 키(pepper).
# - 반드시 무작위 고엔트로피 값(예: `openssl rand -hex 32`)을 사용한다.
# - 절대 커밋하지 않는다. 로컬에서는 .env.local, 배포 환경에서는 Secret Manager/Vercel Env 사용.
# - 회전(rotation)이 필요하면 기존 해시를 재계산하는 마이그레이션이 필요하므로 신중히 다룬다.
IDENTITY_PEPPER=change-me-to-a-random-64-char-hex-string

# 세션 쿠키 서명에 사용하는 별도의 비밀 키 (IDENTITY_PEPPER와 반드시 다른 값 사용)
SESSION_SECRET=change-me-to-a-different-random-secret
