# PostgreSQL 연결 문자열 (로컬 개발용 예시)
DATABASE_URL=postgres://gaiara:gaiara@localhost:5432/gaiara

# 내부 식별자 해싱에 사용하는 서버 전용 비밀 키(pepper). 현재는
# `/result`의 2촌 이상 익명 노드 id(lib/opaque-id.ts)를 가리는 데 쓴다.
# - 반드시 무작위 고엔트로피 값(예: `openssl rand -hex 32`)을 사용한다.
# - 절대 커밋하지 않는다. 로컬에서는 .env.local, 배포 환경에서는 Secret Manager/Vercel Env 사용.
# - 회전(rotation)이 필요하면 기존 해시를 재계산하는 마이그레이션이 필요하므로 신중히 다룬다.
IDENTITY_PEPPER=change-me-to-a-random-64-char-hex-string

# 세션 쿠키 서명에 사용하는 별도의 비밀 키 (IDENTITY_PEPPER와 반드시 다른 값 사용)
SESSION_SECRET=change-me-to-a-different-random-secret

# TASK-003(v2) — 카카오 로그인(Auth.js). 카카오 디벨로퍼스에서 앱을 만들어
# 발급받는 REST API 키/Client Secret이다. 아직 발급 전이라면 비워두면
# 되고, 그 상태에서는 /api/auth/*, /login, /invite/[token]이 명확한 503으로
# 실패한다(코드/타입체크 자체는 값 없이도 통과한다).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Auth.js(NextAuth) 자체 세션/CSRF 서명에 필요한 비밀 키. IDENTITY_PEPPER/
# SESSION_SECRET과 다른 무작위 값을 쓴다(예: `openssl rand -hex 32`).
NEXTAUTH_SECRET=change-me-to-a-random-secret

# 로컬 개발 기본값은 Auth.js가 요청 헤더로 추론하지만, 배포 환경에서는
# 명시적으로 설정하는 것을 권장한다.
NEXTAUTH_URL=http://localhost:3000

# `/result` 미니 그래프에서 2촌 이상 익명 노드를 몇 개까지 렌더링할지.
# 최종 제품 정책값이 아니라 실기기 성능 테스트 전까지의 초기값(40)이라
# 코드 배포 없이 조정할 수 있게 환경 변수로 뒀다. 비워두면 기본값(40)을
# 쓴다. direct(1촌)는 이 값과 무관하게 항상 전부 보여준다.
RESULT_MAX_BEYOND_NODES=40
