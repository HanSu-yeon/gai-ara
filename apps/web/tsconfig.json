{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    // `lib/*.test.ts`는 Node 내장 테스트 러너(`node --test`)로 돌린다 —
    // 러너가 확장자까지 적힌 상대 경로만 해석하므로 tsc에도 허용해준다.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
